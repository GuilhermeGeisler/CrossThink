#!/bin/sh
#
# Pre-commit hook: runs clang-format, cppcheck, and clang-tidy on staged C++ files
#

set -e

# Git hooks run with minimal PATH — ensure standard tool locations are included
export PATH="/usr/bin:/usr/local/bin:$PATH"

# Colors for output (POSIX-compatible: printf, not echo -e)
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { printf "${GREEN}✓ %s${NC}\n" "$1"; }
warn()  { printf "${YELLOW}⚠ %s${NC}\n" "$1"; }
error() { printf "${RED}✗ %s${NC}\n" "$1"; }

echo "Running pre-commit checks..."

# Get list of staged C++ files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp|c)$' || true)

if [ -z "$STAGED_FILES" ]; then
  info "No C++ files to check"
  exit 0
fi

# Check tool availability
CLANG_FORMAT_AVAILABLE=false
CPPCHECK_AVAILABLE=false
CLANG_TIDY_AVAILABLE=false

if command -v clang-format > /dev/null 2>&1; then
  CLANG_FORMAT_AVAILABLE=true
else
  warn "clang-format not found, skipping format check"
fi

if command -v cppcheck > /dev/null 2>&1; then
  CPPCHECK_AVAILABLE=true
else
  warn "cppcheck not found, skipping static analysis"
fi

if command -v clang-tidy > /dev/null 2>&1; then
  CLANG_TIDY_AVAILABLE=true
else
  warn "clang-tidy not found, skipping deep analysis"
fi

# Track if any checks fail
FAILED=false

# Run clang-format
if [ "$CLANG_FORMAT_AVAILABLE" = true ]; then
  echo "Checking code format..."
  FORMAT_ISSUES=""

  for file in $STAGED_FILES; do
    # Skip generated files
    if echo "$file" | grep -qE '(generated|builtinFonts)'; then
      continue
    fi

    # Check if file needs formatting
    if ! clang-format --dry-run --Werror "$file" 2>/dev/null; then
      FORMAT_ISSUES="$FORMAT_ISSUES $file"
    fi
  done

  if [ -n "$FORMAT_ISSUES" ]; then
    error "Format issues found in:"
    for file in $FORMAT_ISSUES; do
      echo "  - $file"
    done
    echo ""
    echo "Fix with: clang-format -i $FORMAT_ISSUES"
    FAILED=true
  else
    info "Code format OK"
  fi
fi

# Run cppcheck
if [ "$CPPCHECK_AVAILABLE" = true ]; then
  echo "Running static analysis (cppcheck)..."

  if ! cppcheck --enable=warning,style,performance,portability \
                --error-exitcode=1 \
                --quiet \
                --inline-suppr \
                --std=c++20 \
                --language=c++ \
                --suppress=missingIncludeSystem \
                --suppress=unusedFunction \
                --suppress=unmatchedSuppression \
                --suppress=knownConditionTrueFalse \
                --suppress=useStlAlgorithm \
                --suppress=unreadVariable \
                --suppress=unusedStructMember \
                --suppress=unusedMemberVariable \
                $STAGED_FILES 2>&1; then
    error "cppcheck found issues"
    FAILED=true
  else
    info "cppcheck OK"
  fi
fi

# Run clang-tidy (deep analysis)
if [ "$CLANG_TIDY_AVAILABLE" = true ]; then
  echo "Running deep analysis (clang-tidy)..."

  # Check if compile_commands.json exists
  if [ ! -f "compile_commands.json" ]; then
    warn "compile_commands.json not found, generating..."
    if command -v pio > /dev/null 2>&1; then
      pio run -t compiledb -e default > /dev/null 2>&1 || true
    fi
  fi

  TIDY_ISSUES=""
  for file in $STAGED_FILES; do
    # Skip generated files and third-party code
    if echo "$file" | grep -qE '(generated|builtinFonts|expat|uzlib)'; then
      continue
    fi

    # Run clang-tidy (warnings only, not errors for now)
    if ! clang-tidy "$file" -p . --quiet 2>&1 | grep -q "^$file:[0-9]*:[0-9]*: warning:"; then
      : # No warnings
    else
      TIDY_ISSUES="$TIDY_ISSUES $file"
    fi
  done

  if [ -n "$TIDY_ISSUES" ]; then
    warn "clang-tidy found warnings in:"
    for file in $TIDY_ISSUES; do
      echo "  - $file"
    done
    echo ""
    echo "Run for details: ./scripts/run-clang-tidy.sh"
  else
    info "clang-tidy OK"
  fi
fi

# Final result
if [ "$FAILED" = true ]; then
  echo ""
  error "Pre-commit checks failed"
  echo "Fix the issues above or use 'git commit --no-verify' to bypass (not recommended)"
  exit 1
else
  echo ""
  info "All pre-commit checks passed"
  exit 0
fi
